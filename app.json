{
  "expo": {
    "name": "Akorno",
    "slug": "akorno-bible-chat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/avatars/peter.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/onboarding_disciples_hero.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "scheme": "akorno",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.akorno.biblechat"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/avatars/peter.png",
        "backgroundColor": "#0A0A0A"
      },
      "package": "com.akorno.biblechat"
    },
    "web": {
      "favicon": "./assets/avatars/peter.png"
    },
    "plugins": [
      "expo-font",
      "expo-sqlite",
      "expo-secure-store",
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "eas": {
        "projectId": "e6516bcf-a6ff-453c-890c-66112344f684"
      }
    }
  }
}
